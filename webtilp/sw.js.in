const CACHE_VERSION = '__BUILD_ID__';
const CACHE_NAME = `webtilp-${CACHE_VERSION}`;

const PRECACHE_URLS = [
  'webtilp.html',
  'index.html',
  'app.bundle.js',
  'numworks_backend.bundle.js',
  'app.css',
  'highlighter.min.js',
  'build-profile.css',
  'webtilp.js',
  'webtilp.wasm',
  'TIVarsLib.js',
  'TIVarsLib.wasm',
  'WebLuna.js',
  'WebLuna.wasm',
  'webtilp_prejs.js',
  'version.json',
  'site.webmanifest',
  'favicon.ico',
  'favicon-16x16.png',
  'favicon-32x32.png',
  'apple-touch-icon.png',
  'android-chrome-192x192.png',
  'android-chrome-512x512.png',
  'webtilp.png',
  'webtilp_noshadow.png',
  'webtilp_medium.png',
  'i18n/fr.json',
  'i18n/nl.json',
  'i18n/it.json',
  'i18n/de.json',
  'i18n/es.json',
  'i18n/pt.json',
  'i18n/sv.json',
  'i18n/zh.json'
];

// Like coi-serviceworker, synthesize isolation headers for hosts such as GitHub
// Pages. Keep this in the offline worker: only one worker can control this scope.
function isolatedResponse(response) {
  if (response.status === 0) {
    return response; // Opaque responses cannot be reconstructed.
  }
  const headers = new Headers(response.headers);
  headers.set('Cross-Origin-Opener-Policy', 'same-origin');
  headers.set('Cross-Origin-Embedder-Policy', 'require-corp');
  return new Response(response.body, {
    status: response.status,
    statusText: response.statusText,
    headers
  });
}

async function cacheResponse(cache, request, response) {
  if (!response || !response.ok) {
    return;
  }
  const cacheControl = response.headers.get('cache-control') || '';
  if (cacheControl.toLowerCase().includes('no-store')) {
    const headers = new Headers(response.headers);
    headers.delete('cache-control');
    headers.delete('vary');
    const body = await response.clone().blob();
    const sanitized = new Response(body, {
      status: response.status,
      statusText: response.statusText,
      headers
    });
    await cache.put(request, sanitized);
    return;
  }
  await cache.put(request, response.clone());
}

self.addEventListener('install', event => {
  const base = self.location.href.replace(/[^/]*$/, '');
  const precacheRequests = PRECACHE_URLS.map(url => new URL(url, base).toString());
  event.waitUntil(
    caches.open(CACHE_NAME).then(cache => Promise.all(
      precacheRequests.map(async url => {
        try {
          const response = await fetch(url, { cache: 'no-store' });
          await cacheResponse(cache, url, response);
        } catch {
          // ignore
        }
      })
    )).then(() => self.skipWaiting())
  );
});

self.addEventListener('activate', event => {
  event.waitUntil(
    (async () => {
      const cache = await caches.open(CACHE_NAME);
      const hasShell = await cache.match('webtilp.html');
      if (hasShell) {
        const keys = await caches.keys();
        await Promise.all(keys.filter(key => key.startsWith('webtilp-') && key !== CACHE_NAME).map(key => caches.delete(key)));
      }
      await self.clients.claim();
    })()
  );
});

self.addEventListener('fetch', event => {
  if (event.request.method !== 'GET'
      || (event.request.cache === 'only-if-cached' && event.request.mode !== 'same-origin')) {
    return;
  }
  const url = new URL(event.request.url);
  if (url.origin !== self.location.origin) {
    return;
  }
  event.respondWith((async () => {
    const cache = await caches.open(CACHE_NAME);
    const cached = await cache.match(event.request, { ignoreSearch: true, ignoreVary: true });
    try {
      const response = await fetch(event.request);
      // A full/disabled cache must not turn a successful network fetch into a failure.
      try {
        await cacheResponse(cache, event.request, response);
      } catch (error) {
        console.warn('[WebTILP] Could not cache response.', error);
      }
      return isolatedResponse(response);
    } catch {
      if (cached) {
        return isolatedResponse(cached);
      }
      if (event.request.mode === 'navigate') {
        const fallback = await cache.match('webtilp.html');
        if (fallback) {
          return isolatedResponse(fallback);
        }
      }
      throw new Error('Offline and no cached response.');
    }
  })());
});

self.addEventListener('message', event => {
  if (event.data?.type === 'GET_ISOLATION_STATUS') {
    event.ports[0]?.postMessage({ type: 'ISOLATION_READY', version: CACHE_VERSION });
  }
  if (event.data && event.data.type === 'SKIP_WAITING') {
    self.skipWaiting();
  }
});
